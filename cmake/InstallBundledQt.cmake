# Копіює runtime Qt з офіційного інсталятора в ${CMAKE_INSTALL_PREFIX}/${MK61_BUNDLE_LIBDIR}.
# Викликається з install(CODE). DESTDIR приходить через ENV{DESTDIR}.
if(NOT DEFINED MK61_QT_PREFIX OR MK61_QT_PREFIX STREQUAL "")
  message(FATAL_ERROR "MK61_QT_PREFIX is empty")
endif()
if(NOT DEFINED MK61_BUNDLE_LIBDIR)
  set(MK61_BUNDLE_LIBDIR "lib/mk61emu")
endif()

set(_dst "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/${MK61_BUNDLE_LIBDIR}")
file(MAKE_DIRECTORY "${_dst}")
file(MAKE_DIRECTORY "${_dst}/plugins")

function(mk61_install_so_glob pattern)
  file(GLOB _files ${pattern})
  foreach(_src IN LISTS _files)
    get_filename_component(_name "${_src}" NAME)
    if(NOT _name MATCHES "\\.debug$" AND NOT _name MATCHES "\\.prl$" AND NOT _name MATCHES "\\.a$")
      file(COPY "${_src}" DESTINATION "${_dst}")
    endif()
  endforeach()
endfunction()

foreach(_mod Core Gui Widgets DBus XcbQpa)
  mk61_install_so_glob("${MK61_QT_PREFIX}/lib/libQt6${_mod}.so*")
endforeach()
mk61_install_so_glob("${MK61_QT_PREFIX}/lib/libicuuc.so*")
mk61_install_so_glob("${MK61_QT_PREFIX}/lib/libicui18n.so*")
mk61_install_so_glob("${MK61_QT_PREFIX}/lib/libicudata.so*")

function(mk61_install_plugin_files subdir)
  set(_out "${_dst}/plugins/${subdir}")
  file(MAKE_DIRECTORY "${_out}")
  foreach(_name IN LISTS ARGN)
    set(_src "${MK61_QT_PREFIX}/plugins/${subdir}/${_name}")
    if(EXISTS "${_src}")
      file(COPY "${_src}" DESTINATION "${_out}")
    endif()
  endforeach()
endfunction()

function(mk61_install_plugin_dir subdir)
  set(_src_dir "${MK61_QT_PREFIX}/plugins/${subdir}")
  if(NOT EXISTS "${_src_dir}")
    return()
  endif()
  set(_out "${_dst}/plugins/${subdir}")
  file(MAKE_DIRECTORY "${_out}")
  file(GLOB _plugs "${_src_dir}/*.so")
  foreach(_src IN LISTS _plugs)
    file(COPY "${_src}" DESTINATION "${_out}")
  endforeach()
endfunction()

mk61_install_plugin_files(platforms libqxcb.so)
mk61_install_plugin_files(platforminputcontexts libcomposeplatforminputcontextplugin.so)
mk61_install_plugin_dir(xcbglintegrations)

file(WRITE "${_dst}/qt.conf" "[Paths]\nPrefix = .\nPlugins = plugins\nLibraries = .\n")

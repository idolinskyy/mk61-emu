if(NOT DEFINED MK61_VERSION OR NOT DEFINED MK61_TEMPLATE OR NOT DEFINED MK61_OUTPUT)
  message(FATAL_ERROR "write_build_info.cmake: потрібні MK61_VERSION, MK61_TEMPLATE, MK61_OUTPUT")
endif()

set(MK61EMU_VERSION_STRING "${MK61_VERSION}")
string(TIMESTAMP MK61EMU_BUILD_TIME "%Y-%m-%dT%H:%M:%S" UTC)
string(TIMESTAMP MK61EMU_BUILD_TIME_READABLE "%d.%m.%Y %H:%M:%S UTC" UTC)

get_filename_component(_outdir "${MK61_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_outdir}")
configure_file("${MK61_TEMPLATE}" "${MK61_OUTPUT}" @ONLY)
